#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SOTTRVR_VERSION_MAJOR,SOTTRVR_VERSION_MINOR,SOTTRVR_VERSION_PATCH,0
 PRODUCTVERSION SOTTRVR_VERSION_MAJOR,SOTTRVR_VERSION_MINOR,SOTTRVR_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "jcooray"
            VALUE "FileDescription", "Shadow of the Tomb Raider VR (DXGI proxy)"
            VALUE "FileVersion", SOTTRVR_VERSION_STRING
            VALUE "ProductName", "Shadow of the Tomb Raider VR"
            VALUE "ProductVersion", SOTTRVR_VERSION_STRING
            VALUE "LegalCopyright", "Copyright (c) 2026 jcooray. GPL-3.0-or-later."
            VALUE "OriginalFilename", "dxgi.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
